SELF_URL=
BOT_TOKEN_MAIN=
BOT_TOKEN=
SUPPORT_CHAT_ID_MAIN=
SUPPORT_CHAT_ID=
PORT=
MONGODB_URI=
MONGODB_DB=

# Google Workspace — автоматичне скидання пароля
# Шлях до Service Account Key JSON (кладіть файл у secrets/, він в .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Email супер-адміна домену, від імені якого імперсонує сервісний акаунт
# (той, що вказаний як impersonate/subject у domain-wide delegation)
GOOGLE_WORKSPACE_ADMIN_EMAIL=
# Домен Google Workspace (без @)
GOOGLE_WORKSPACE_DOMAIN=oano.ukr.education
